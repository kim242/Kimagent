# ═══════════════════════════════════════════════════════════════════════════
# Kimagent — configuration (copiez ce fichier vers `.env` puis complétez)
# ═══════════════════════════════════════════════════════════════════════════

# ── Boutique Chariow ─────────────────────────────────────────────────────────
# Endpoint du serveur MCP officiel (ne changez que si Chariow l'indique)
# CHARIOW_MCP_URL=https://mcp.chariow.com/public

# Clé API Chariow (OBLIGATOIRE seulement pour les ACTIONS via l'API REST :
# invitations affiliés, etc.). À créer dans app.chariow.com → Paramètres → API Keys.
# Les lectures (MCP) n'en ont pas besoin : l'authentification se fait par OAuth
# avec `kimagent auth`.
# CHARIOW_API_KEY=chw_live_xxxxxxxxxxxxxxxxxxxx
# CHARIOW_STORE_SLUG=mon-slug

# ── Cerveau IA (choisissez UN fournisseur) ───────────────────────────────────
# Valeurs possibles : anthropic | openai | ollama | none
#   anthropic → utilise l'API Claude (nécessite ANTHROPIC_API_KEY)
#   openai    → utilise l'API OpenAI (nécessite OPENAI_API_KEY)
#   ollama    → modèle local gratuit (lancez Ollama : https://ollama.com)
#   none      → Kimagent écrit des prompts prêts à copier dans votre IA
#               (Claude Desktop, ChatGPT, Cursor…) — idéal pour démarrer
KIMAGENT_BRAIN=none

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_MODEL=gpt-4o

# Ollama (local, gratuit)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5

# ── Objectif de vente (agent "objectif") ─────────────────────────────────────
# Objectif de chiffre d'affaires sur 30 jours, en FCFA (XAF)
# KIMAGENT_OBJECTIF_XAF=800000
# Devise principale de la boutique (utilisée pour convertir les montants)
# KIMAGENT_STORE_CURRENCY=EUR

# ── Réglages divers ──────────────────────────────────────────────────────────
# Âge maximum du cache local avant re-récupération (heures)
# KIMAGENT_DATA_MAX_AGE_H=12
# Nombre max de caractères de contexte envoyé au LLM
# KIMAGENT_CONTEXT_MAX_CHARS=30000
